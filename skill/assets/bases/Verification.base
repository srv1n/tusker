filters:
  and:
    - 'file.ext == "md"'
    - 'type == "story" || type == "bug"'
    - 'status == "in_review"'
    - 'review_state == "verification_requested"'
properties:
  "file.name":
    displayName: "ID"
  title:
    displayName: "Title"
  risk:
    displayName: "Risk"
  priority:
    displayName: "Priority"
  epic:
    displayName: "Epic"
  assignee:
    displayName: "Assignee"
  ai_assistance:
    displayName: "AI"
  review_opened:
    displayName: "Verification opened"
views:
  - type: table
    name: "Queue"
    order:
      - "file.name"
      - title
      - risk
      - priority
      - epic
      - assignee
      - ai_assistance
      - review_opened
