filters:
  and:
    - 'file.ext == "md"'
    - 'type == "bug"'
    - 'status != "cancelled"'
properties:
  "file.name":
    displayName: "ID"
  title:
    displayName: "Title"
  status:
    displayName: "Status"
  risk:
    displayName: "Risk"
  priority:
    displayName: "Priority"
  epic:
    displayName: "Epic"
  surfaces:
    displayName: "Surfaces"
  assignee:
    displayName: "Assignee"
  ai_assistance:
    displayName: "AI"
  due:
    displayName: "Due"
views:
  - type: table
    name: "Board"
    groupBy:
      property: note.status
      direction: ASC
    order:
      - "file.name"
      - title
      - risk
      - priority
      - assignee
      - due
  - type: table
    name: "Open"
    filters:
      and:
        - 'status != "done"'
    order:
      - "file.name"
      - title
      - risk
      - priority
      - epic
      - assignee
      - due
  - type: table
    name: "By risk"
    order:
      - "file.name"
      - risk
      - title
      - status
      - priority
      - assignee
