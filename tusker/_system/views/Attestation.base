filters:
  and:
    - 'file.ext == "md"'
    - 'type == "story" || type == "bug"'
    - 'status == "in_review"'
    - 'review_state == "requested" || review_state == "approved"'
properties:
  "file.name":
    displayName: "ID"
  title:
    displayName: "Title"
  risk:
    displayName: "Risk"
  size:
    displayName: "Size"
  priority:
    displayName: "Priority"
  epic:
    displayName: "Epic"
  assignee:
    displayName: "Assignee"
  ai_assistance:
    displayName: "AI"
  review_opened:
    displayName: "Review opened"
  attested_by:
    displayName: "Attested by"
  signoff_by:
    displayName: "Signoff"
views:
  - type: table
    name: "Queue"
    order:
      - "file.name"
      - title
      - risk
      - priority
      - epic
      - assignee
      - ai_assistance
      - review_opened
      - attested_by
      - signoff_by
  - type: table
    name: "By risk"
    groupBy:
      property: note.risk
      direction: ASC
    order:
      - "file.name"
      - title
      - priority
      - assignee
      - review_opened
  - type: table
    name: "Critical awaiting signoff"
    filters:
      and:
        - 'risk == "critical"'
        - 'signoff_by == ""'
    order:
      - "file.name"
      - title
      - epic
      - assignee
      - attested_by
      - review_opened
