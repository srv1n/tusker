+	plan.Tasks[0].ConcurrencyGroup = ""
+	plan.Tasks[0].Architect = ""
+	plan.Tasks[0].Origin = ""
+	plan.Tasks[0].Peers = nil
+	plan.Tasks[0].Dependencies = nil
