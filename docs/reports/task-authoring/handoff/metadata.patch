+	if err := deliveryImportCmd(Args{"vault": vault, "plan": planPath, "quiet": "true"}); err != nil {
+		t.Fatal(err)
+	}
+
+	path := filepath.Join(vault, "work", "tasks", "APP-T-0001.md")
+	data, body, err := parseFrontmatterMustRead(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{
+		"architect", "origin", "runner_profile", "concurrency_group", "peer_contacts", "domains", "gates", "dependencies", "knowledge_nodes", "owned_paths", "evidence_required",
+	} {
+		if _, ok := data[key]; ok {
+			t.Fatalf("new imported task should omit empty %s: %#v", key, data[key])
+		}
+	}
+	assertEqual(t, false, boolField(data, "raw_artifacts_allowed"), "imported raw artifact policy")
+	assertEqual(t, 0, intField(data, "evidence_budget"), "imported evidence budget")
+	if _, present := data["evidence_budget"]; !present {
+		t.Fatal("import must preserve the explicit zero evidence cap")
+	}
+	assertEqual(t, "task", stringField(data, "next_source"), "imported next source")
+	assertEqual(t, "APP-T-0001", stringField(data, "next_ref"), "imported next ref")
+	if !v7StateRevMatches(data, body, stringField(data, "state_rev")) {
+		t.Fatalf("new imported task state_rev does not match trimmed content")
+	}
