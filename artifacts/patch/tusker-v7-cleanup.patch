+func automationPlanProofRequired(note Note) []string {
+	proof := normalizeList(note.Data["proof_required"])
+	if len(proof) > 0 {
+		return proof
+	}
+	return defaultV7ProofRequired(strings.TrimSpace(stringField(note.Data, "proof_mode")))
