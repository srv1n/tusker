-    .replace(/!\[[^\]]*\]\([^)]+\)/g, '')
-    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
-    .replace(/\n{3,}/g, '\n\n')
-    .trim();
-  for (const chunk of cleaned.split('\n\n')) {
-    const paragraph = chunk
-      .split('\n')
-      .map((line) => line.trim())
-      .join(' ')
-      .trim();
-    if (!paragraph) continue;
-    if (paragraph.startsWith('Status:')) continue;
-    if (paragraph.startsWith('Scope:')) continue;
-    return paragraph.replace(/\s+/g, ' ');
-  }
