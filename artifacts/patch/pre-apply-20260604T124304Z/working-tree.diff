+        print(json.dumps({"jsonrpc":"2.0","method":"applyPatchApproval","id":"approve-patch","params":{"cwd":os.environ["TUSKER_WORKSPACE"],"changes":[{"path":"reviewed.txt"}]}}), flush=True)
